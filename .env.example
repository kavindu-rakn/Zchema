# Copy to .env.local and fill in from your Supabase project:
#   Dashboard → Project Settings → API
#
# Both values are public by design. The anon key ships to every browser;
# what protects the data is Row Level Security (supabase/policies.sql).
# Never put the service_role key in this file — nothing in this app needs it,
# and a NEXT_PUBLIC_ variable would expose it to every visitor.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. The public origin the app is served from, used for the
# absolute URLs in link previews (og:image, og:url) and the canonical
# link. Leave unset on Vercel — VERCEL_PROJECT_PRODUCTION_URL covers
# production deploys — and set it once a custom domain is in front.
# NEXT_PUBLIC_SITE_URL=https://zchema.example.com
