            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_category_id\": \"{{categoryId}}\",\n  \"p_new_own_fields\": [\n    {\n      \"key\": \"brand\",\n      \"label\": \"Brand\",\n      \"type\": \"string\",\n      \"required\": true,\n      \"position\": 0\n    }\n  ],\n  \"p_new_overrides\": {}\n}"
            },
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/rpc/analyze_schema_change",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "rest",
                "v1",
                "rpc",
                "analyze_schema_change"
              ]
            },
            "description": "READ-ONLY. The blast radius of a proposed change: affected categories, item counts, per-change severity, and whether it is blocked outright. Called on every keystroke by the editor's severity badge, so it must never write."
          },
          "response": []
        },
        {
          "name": "apply_schema_change",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{anonKey}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"p_category_id\": \"{{categoryId}}\",\n  \"p_new_own_fields\": [\n    {\n      \"key\": \"brand\",\n      \"label\": \"Brand\",\n      \"type\": \"string\",\n      \"required\": true,\n      \"position\": 0\n    }\n  ],\n  \"p_new_overrides\": {},\n  \"p_remediations\": {\n    \"brand\": {\n      \"strategy\": \"backfill\",\n      \"value\": \"Unknown\"\n    }\n  },\n  \"p_changed_by\": null\n}"
            },
            "url": {
              "raw": "{{supabaseUrl}}/rest/v1/rpc/apply_schema_change",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "rest",
                "v1",
                "rpc",
                "apply_schema_change"
              ]
            },
            "description": "Applies the change in ONE transaction, with a remediation per destructive consequence. Refuses when a destructive change has no strategy; 'discard' additionally requires \"confirm\": true."
          },
          "response": []
        },
